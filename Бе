                            <button class="btn-delete" title="Удалить">🗑️</button>
                        </td>
                    </tr>
                <?php endforeach; ?>
            <?php else: ?>
                <tr>
                    <td colspan="8" style="text-align: center;">Товаров пока нет.</td>
                </tr>
            <?php endif; ?>
        </tbody>
    </table>
