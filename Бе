<?php
// 1. Подключение к БД
$host = 'localhost';
$user = 'root';
$pass = '';
$dbname = 'shop';
$connect = new mysqli($host, $user, $pass, $dbname);

if ($connect->connect_error) {
    die('Ошибка подключения: ' . $connect->connect_error);
}
$connect->set_charset("utf8mb4");

// 2. Запрос на получение всех товаров с категориями и брендами
$sql = "SELECT 
            p.id, 
            p.name, 
            p.price, 
            p.rating, 
            p.stock, 
            pi.image as image,
            c.name as category_name,
            b.name as brand_name
        FROM products p
        LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_main = 1
        LEFT JOIN categories c ON c.id = p.category_id
        LEFT JOIN brands b ON b.id = p.brand_id
        ORDER BY p.id DESC"; // Сортируем по убыванию ID (новые сверху)

$result = $connect->query($sql);

if (!$result) {
    die('Ошибка запроса: ' . $connect->error);
}

// Получаем все товары в массив
$products = $result->fetch_all(MYSQLI_ASSOC);
?>

<link rel="stylesheet" href="../css/style.css"> <!-- Обратите внимание на ../ (если css в корне) -->

<section class="panel">
    <div class="panel-header">
        <h2>Список товаров</h2>
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>Фото</th>
